{
  "name": "dsh-context-keeper",
  "version": "0.1.1",
  "description": "Native DSH context manager: model-facing context tools (status/search/restore/compact) plus incremental, reversible auto-compaction for long sessions.",
  "license": "MIT",
  "author": "YansongG-HKU",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YansongG-HKU/dsh-context-keeper.git"
  },
  "homepage": "https://github.com/YansongG-HKU/dsh-context-keeper#readme",
  "bugs": {
    "url": "https://github.com/YansongG-HKU/dsh-context-keeper/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "context-management",
    "context-compaction",
    "token-saving",
    "prompt-cache",
    "agent",
    "compaction"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/events.test.mjs test/session.test.mjs test/tools.test.mjs test/auto.test.mjs test/plugin.test.mjs test/ui.test.mjs test/runtime-format.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "manifestVersion": 1
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1"
  }
}
